{
  // global safety
  "files.eol": "\n",

  // Makefiles: force tabs, no auto-detect
  "[makefile]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.formatOnSave": false,
    "editor.renderWhitespace": "all"
  },

  // help VS Code recognize Makefiles
  "files.associations": {
    "Makefile": "makefile",
    "makefile": "makefile",
    "*.mk": "makefile"
  }
}