{
    "version": 4,
    "configurations": [
        {
            "name": "/opt/homebrew/bin/avr-gcc",
            "compilerPath": "/opt/homebrew/bin/avr-gcc",
            "compilerArgs": [
                "-mmcu=atmega168",
                "-DF_CPU=16000000UL"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/includes/",
                "${workspaceFolder}/includes/isr",
                "${workspaceFolder}/includes/protocols",
                "${workspaceFolder}/includes/screen",
                "${workspaceFolder}/includes/snake",
                "${workspaceFolder}/includes/sram",
                "${workspaceFolder}/includes/tim",
                "${workspaceFolder}/includes/ws2812b",
                "${workspaceFolder}/src/",
                "${workspaceFolder}/src/isr",
                "${workspaceFolder}/src/protocols",
                "${workspaceFolder}/src/screen",
                "${workspaceFolder}/src/snake",
                "${workspaceFolder}/src/sram",
                "${workspaceFolder}/src/tim",
                "${workspaceFolder}/src/ws2812b"
            ],
            "defines": [
                "__AVR_ATmega168__"
            ],
            "cStandard": "${default}",
            "cppStandard": "${default}",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ]
}