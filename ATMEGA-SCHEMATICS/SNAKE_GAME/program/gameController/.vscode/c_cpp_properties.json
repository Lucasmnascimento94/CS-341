{
    
    "version": 4,
    "configurations": [
        {
            "name": "macos-clang-arm64",
            "compilerPath": "/usr/bin/avr-gcc",
            "compilerArgs": [
                "-mmcu=atmega168",
                "-DF_CPU=8000000UL"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/",
                "${workspaceFolder}/data_types",
                "${workspaceFolder}/startSetUp",
                "${workspaceFolder}/sram",
                "${workspaceFolder}/games/snake",
                "${workspaceFolder}/startSetUp/uart",
                "${workspaceFolder}/startSetUp/spi",
                "${workspaceFolder}/startSetUp/flash",
                "${workspaceFolder}/libC"
            ],
            "defines": [
                "__AVR_ATmega168__"
            ],
            "cStandard": "${default}",
            "cppStandard": "${default}",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ]
}