{
    "version": 4,
    "configurations": [
        {
            "name": "macos-clang-arm64",
            "compilerPath": "/usr/bin/clang",
            "compilerArgs": [
                "-mmcu=atmega168",
                "-DF_CPU=8000000UL"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/gridController",
                "${workspaceFolder}/gridController/startSetUp",
                "${workspaceFolder}/gridController/startSetUp/sram",
                "${workspaceFolder}/gridController/startSetUp/timer",
                "${workspaceFolder}/gridController/startSetUp/uart",
                "${workspaceFolder}/gridController/startSetUp/ws2812b",
                "${workspaceFolder}/gridController/startSetUp/spi",
                "${workspaceFolder}/gridController/startSetUp/isr",
                "${workspaceFolder}/gridController/startSetUp/flash",
                "${workspaceFolder}/gridController/snake",
                "${workspaceFolder}/gridController/libC"
            ],
            "defines": [
                "__AVR_ATmega168__"
            ],
            "cStandard": "${default}",
            "cppStandard": "${default}",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ]
}